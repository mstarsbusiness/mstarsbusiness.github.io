# 辰星官網 — 自訂錯誤頁
ErrorDocument 404 /404.html

# 網址統一（2026-09-27 依〈SEO＋GEO 網站工程師執行說明書〉P0）：正式網址只有一個
#   https://www.morning-stars.com.tw/ —— 不帶 www 與 /index.html 一律 301 導過來，
#   避免 Google/Bing/AI 把同一頁當成多個網址、Backlink 權重分散。
# ⚠️ 三個不要動的理由：
#   ① index.html→/ 一定要用 THE_REQUEST 判斷「外部請求」——首頁本來就由 index.html
#      內部服務（DirectoryIndex），直接 RewriteRule 會無限轉址、全站掛掉。
#   ② http→https 主機層已經在做（實測 http 一律 301 到 https），這裡刻意不再寫一條，
#      虛擬主機上 %{HTTPS} 變數若讀不到會變成轉址迴圈。
#   ③ 包在 IfModule 裡＝主機沒開 mod_rewrite 也不會讓全站 500。
<IfModule mod_rewrite.c>
RewriteEngine On
# 🔒 2026-10-24 資安第八輪：內部檔一律回 404（不讓人知道它存在），放最前面＝比轉址先擋。
#   ① 點開頭的檔（.ftp-deploy-sync-state.json 會列出全站檔名與雜湊）；.well-known 保留給 SSL 憑證驗證
#   ② 建置／檢查工具（build-journal.js、validate-site.js、工具_*.js——最後一個用 UTF-8 位元組寫，維持指令列純 ASCII）
#   ③ 說明文件、備份、腳本類副檔名
#   用 RewriteRule 不用 Require：本主機已證實允許 RewriteRule；Require 需要另一種覆寫權限，萬一沒開會全站 500。
RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]
RewriteRule ^(build-journal|validate-site)\.js$ - [R=404,L]
RewriteRule ^\xE5\xB7\xA5\xE5\x85\xB7_[^/]*\.js$ - [R=404,L]
RewriteRule \.(md|bak|old|orig|sql|log|sh|bat|ps1|py|swp)$ - [R=404,L]
# /index.html → /（只攔外部請求；放在前面＝non-www 的 /index.html 一跳就到位，不串兩層轉址）
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ https://www.morning-stars.com.tw/ [R=301,L]
# 不帶 www → www（本檔規則＝現行唯一有效的 WWW 導向，勿移除）：
# 2026-11-04 曾依捕夢網客服單 PID 900458 建議移除實測——結果 https://morning-stars.com.tw 直接 200
# 出頁＝主機層的「WWW 導向」無效（研判寫在被本站 FTP 部署覆蓋的伺服器端 .htaccess），同日還原。
# 除非捕夢網確認已改在「虛擬主機／網域層級」設定且實測 301 正常，否則不要再拿掉這兩行。
RewriteCond %{HTTP_HOST} ^morning-stars\.com\.tw$ [NC]
RewriteRule ^(.*)$ https://www.morning-stars.com.tw/$1 [R=301,L]
</IfModule>

# 舊網址導回（2026-09-25 Search Console「找不到網頁 (404)」）：
# 早期貼文內文用相對路徑連服務頁（例：office-guide.html），在 /posts/ 底下會變成
# /posts/office-guide.html 這種根本不存在的網址；9/13 已把內文連結全部改成完整網址，
# 但 Google 已記住舊網址 → 301 導回正確頁面，保住連結價值並讓報表結案。
# 貼文檔名一律是 UUID，不會和下列服務頁同名，導向不會誤傷真的貼文。
<IfModule mod_alias.c>
RedirectMatch 301 ^/posts/(office-guide|virtual-office|private-office|meeting-room|meeting-room-price|registration-check|company-setup|mail-handling|wtc|xinyi|journal|index)\.html$ https://www.morning-stars.com.tw/$1.html

# 兩館短網址（2026-10-28）：簡單創等第三方平台的網址欄只收 40 字，完整網址被截成 /xinyi.h → 404。
# /xinyi、/wtc（不帶副檔名）與被截斷的 .h／.htm 一律 301 到正式頁；不會碰到 xinyi-01.jpg 這類檔名。
RedirectMatch 301 ^/(xinyi|wtc)(\.h|\.htm)?$ https://www.morning-stars.com.tw/$1.html

# 根目錄 4 個「副檔名 .html 的 JPG」（2026-10-28 移到 CRM 交接文件歸檔）：同名貼文在 /posts/ 底下，舊網址導過去。
RedirectMatch 301 ^/(9291514c-3bea-4d29-9cc3-8a8953967708|seminar-survey-2026|xinyi-xmas-2025)\.html$ https://www.morning-stars.com.tw/posts/$1.html
# wtc-coming-soon-2025 的貼文本身已整併到世貿館頁（見下方 2026-11-15 段）→ 根目錄舊網址直接導到終點，不多跳一次。
Redirect 301 /wtc-coming-soon-2025.html https://www.morning-stars.com.tw/wtc.html

# 已整併的 16 篇舊文改 301（2026-11-15 老闆核准「T10 官網重複頁改為轉址」）：
# 10/24、11/10 整併時只設 canonical、頁面仍完整輸出，Google 照樣收錄並拿舊文排名
# （11/15 無痕實測：608771e4 排「信義區 借址登記」第 8，主頁 virtual-office 反而不在前 10）。
# 改成主機層 301，把排名訊號集中到主題頁；對照表＝data/posts.json 各篇的 canonical 欄，兩邊要一致。
# build-journal.js 對有 canonical 的文章另輸出「立即跳轉」極簡頁當備援，Journal 列表與延伸閱讀也不再列出。
Redirect 301 /posts/25b2797a-da7b-42bb-9d12-99a502891a21.html https://www.morning-stars.com.tw/wtc.html
Redirect 301 /posts/3e949bdd-78e1-488e-97fe-2154263219bb.html https://www.morning-stars.com.tw/virtual-office.html
Redirect 301 /posts/49655d8c-629b-475b-b083-c88e1e828a4b.html https://www.morning-stars.com.tw/virtual-office.html
Redirect 301 /posts/4aba7592-2124-43bd-a14d-9fb6c12df563.html https://www.morning-stars.com.tw/posts/1977a136-4247-4dc1-95be-2075d0c687cc.html
Redirect 301 /posts/5ef2b7be-38a4-46b0-8f63-449fd7611011.html https://www.morning-stars.com.tw/posts/8845cac6-9aa5-4a14-8400-b19e3bf6320c.html
Redirect 301 /posts/608771e4-d5d1-4d58-9ba2-1ab8a1c73c35.html https://www.morning-stars.com.tw/virtual-office.html
Redirect 301 /posts/9c279a43-168b-4e62-a481-dbf18f96f229.html https://www.morning-stars.com.tw/virtual-office.html
Redirect 301 /posts/a0bec539-11ce-4d58-a68b-6cda909e325c.html https://www.morning-stars.com.tw/posts/afc1b824-0dda-4eb8-a386-32d1d0c35c42.html
Redirect 301 /posts/b6448479-2e01-4b69-b900-7538907c4a9d.html https://www.morning-stars.com.tw/posts/2c0a1c6c-1cf8-4bc5-87da-672d6869cf7e.html
Redirect 301 /posts/d4a4bda3-b365-4aa6-8254-fecab8131ef1.html https://www.morning-stars.com.tw/posts/3cc65dbd-59d6-4890-a8e3-a368b6c2466a.html
Redirect 301 /posts/d6d58a13-23b9-4c64-9923-461adb923950.html https://www.morning-stars.com.tw/virtual-office.html
Redirect 301 /posts/dcd2eec6-fb43-46f6-aa81-0a1530005c55.html https://www.morning-stars.com.tw/posts/1977a136-4247-4dc1-95be-2075d0c687cc.html
Redirect 301 /posts/ef1425d2-10b3-4352-8c7d-5d371d305e64.html https://www.morning-stars.com.tw/posts/8b8fecb3-33cb-476c-979b-55c7db98c766.html
Redirect 301 /posts/f39c59d5-dab3-4acd-87af-00a8ba6b9177.html https://www.morning-stars.com.tw/wtc.html
Redirect 301 /posts/f44bdeaa-0b93-47fe-b32b-4b880a5ca114.html https://www.morning-stars.com.tw/posts/2c0a1c6c-1cf8-4bc5-87da-672d6869cf7e.html
Redirect 301 /posts/wtc-coming-soon-2025.html https://www.morning-stars.com.tw/wtc.html

# 已移除的舊貼文（2026-09-25 老闆指示清掉）：檔案已從 repo 刪除，網址 301 導到同題目的現存貼文，
# 不留 404、保住既有排名。① 9/10 重複發的「借址登記的信件包裹怎麼收？」→ 9/2 原文
# ②「世貿站附近會議室一小時多少錢？」舊版 → 8/14 版 ③「台北市設址登記是什麼？和借址一樣嗎？」→ 8/18「商務中心借址登記是什麼？」
Redirect 301 /posts/332a0b44-f332-4ce4-b418-68b597e94177.html https://www.morning-stars.com.tw/posts/3b328087-1d64-474d-80cc-51a9ec7aaa6e.html
Redirect 301 /posts/cca1bd3e-ba35-436d-93e7-7915f5ab3166.html https://www.morning-stars.com.tw/posts/968ea4f9-a04a-47c0-875d-25b8febad707.html
Redirect 301 /posts/a11340fb-3aa2-4d1a-8a0d-06b3b057fe33.html https://www.morning-stars.com.tw/posts/ea985636-f9a8-476e-992d-444be757baef.html
</IfModule>

# 純文字檔（llms.txt / robots.txt / humans.txt）宣告 UTF-8，
# 避免瀏覽器與 AI 爬蟲讀到中文亂碼。（2026-07-16 每日健檢發現 llms.txt 未帶 charset）
AddType "text/plain; charset=UTF-8" .txt
AddCharset UTF-8 .txt

# 效能（2026-09-21 依 PageSpeed 稽核）：文字資源 gzip 壓縮——PSI「未套用壓縮功能」項
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json text/plain image/svg+xml application/xml
</IfModule>

# 效能：靜態資源快取——PSI「快取 TTL 全為 None、可省 1,060KiB」項
# 注意：i18n.js 靠 ?v= 破快取（改 i18n 必 bump ?v=，既有鐵則）；posts.json 給 10 分鐘讓新貼文快速可見
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/x-icon "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType text/javascript "access plus 7 days"
ExpiresByType application/json "access plus 10 minutes"
ExpiresByType text/html "access plus 10 minutes"
</IfModule>

# 🔒 資安標頭（2026-10-24 資安第八輪；包 IfModule＝主機沒開 mod_headers 也不會 500）
#   HSTS：一年內瀏覽器只走 https（刻意不加 includeSubDomains——cpanel／webmail 等子網域不受影響）
#   nosniff：已實測 .js／.css／.json 的 Content-Type 都正確，加了不會擋到正常檔案
#   SAMEORIGIN＋frame-ancestors：別的網站不能把官網包進 iframe 騙點擊（CRM 沒有內嵌官網，已查）
#   CSP 只放不影響載入的三項；不限制 script 來源（GA、地圖、內嵌程式很多，硬加會整站壞）
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
Header always unset X-Powered-By
</IfModule>
