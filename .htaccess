# 辰星官網 — 自訂錯誤頁
ErrorDocument 404 /404.html

# 網址統一（2026-09-27 依〈SEO＋GEO 網站工程師執行說明書〉P0）：正式網址只有一個
#   https://www.morning-stars.com.tw/ —— 不帶 www 與 /index.html 一律 301 導過來，
#   避免 Google/Bing/AI 把同一頁當成多個網址、Backlink 權重分散。
# ⚠️ 三個不要動的理由：
#   ① index.html→/ 一定要用 THE_REQUEST 判斷「外部請求」——首頁本來就由 index.html
#      內部服務（DirectoryIndex），直接 RewriteRule 會無限轉址、全站掛掉。
#   ② http→https 主機層已經在做（實測 http 一律 301 到 https），這裡刻意不再寫一條，
#      虛擬主機上 %{HTTPS} 變數若讀不到會變成轉址迴圈。
#   ③ 包在 IfModule 裡＝主機沒開 mod_rewrite 也不會讓全站 500。
<IfModule mod_rewrite.c>
RewriteEngine On
# 🔒 2026-10-24 資安第八輪：內部檔一律回 404（不讓人知道它存在），放最前面＝比轉址先擋。
#   ① 點開頭的檔（.ftp-deploy-sync-state.json 會列出全站檔名與雜湊）；.well-known 保留給 SSL 憑證驗證
#   ② 建置／檢查工具（build-journal.js、validate-site.js、工具_*.js——最後一個用 UTF-8 位元組寫，維持指令列純 ASCII）
#   ③ 說明文件、備份、腳本類副檔名
#   用 RewriteRule 不用 Require：本主機已證實允許 RewriteRule；Require 需要另一種覆寫權限，萬一沒開會全站 500。
RewriteRule (^|/)\.(?!well-known(/|$)) - [R=404,L]
RewriteRule ^(build-journal|validate-site)\.js$ - [R=404,L]
RewriteRule ^\xE5\xB7\xA5\xE5\x85\xB7_[^/]*\.js$ - [R=404,L]
RewriteRule \.(md|bak|old|orig|sql|log|sh|bat|ps1|py|swp)$ - [R=404,L]
# /index.html → /（只攔外部請求；放在前面＝non-www 的 /index.html 一跳就到位，不串兩層轉址）
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ https://www.morning-stars.com.tw/ [R=301,L]
# 不帶 www → www
RewriteCond %{HTTP_HOST} ^morning-stars\.com\.tw$ [NC]
RewriteRule ^(.*)$ https://www.morning-stars.com.tw/$1 [R=301,L]
</IfModule>

# 舊網址導回（2026-09-25 Search Console「找不到網頁 (404)」）：
# 早期貼文內文用相對路徑連服務頁（例：office-guide.html），在 /posts/ 底下會變成
# /posts/office-guide.html 這種根本不存在的網址；9/13 已把內文連結全部改成完整網址，
# 但 Google 已記住舊網址 → 301 導回正確頁面，保住連結價值並讓報表結案。
# 貼文檔名一律是 UUID，不會和下列服務頁同名，導向不會誤傷真的貼文。
<IfModule mod_alias.c>
RedirectMatch 301 ^/posts/(office-guide|virtual-office|private-office|meeting-room|meeting-room-price|registration-check|company-setup|mail-handling|wtc|xinyi|journal|index)\.html$ https://www.morning-stars.com.tw/$1.html

# 已移除的舊貼文（2026-09-25 老闆指示清掉）：檔案已從 repo 刪除，網址 301 導到同題目的現存貼文，
# 不留 404、保住既有排名。① 9/10 重複發的「借址登記的信件包裹怎麼收？」→ 9/2 原文
# ②「世貿站附近會議室一小時多少錢？」舊版 → 8/14 版 ③「台北市設址登記是什麼？和借址一樣嗎？」→ 8/18「商務中心借址登記是什麼？」
Redirect 301 /posts/332a0b44-f332-4ce4-b418-68b597e94177.html https://www.morning-stars.com.tw/posts/3b328087-1d64-474d-80cc-51a9ec7aaa6e.html
Redirect 301 /posts/cca1bd3e-ba35-436d-93e7-7915f5ab3166.html https://www.morning-stars.com.tw/posts/968ea4f9-a04a-47c0-875d-25b8febad707.html
Redirect 301 /posts/a11340fb-3aa2-4d1a-8a0d-06b3b057fe33.html https://www.morning-stars.com.tw/posts/ea985636-f9a8-476e-992d-444be757baef.html
</IfModule>

# 純文字檔（llms.txt / robots.txt / humans.txt）宣告 UTF-8，
# 避免瀏覽器與 AI 爬蟲讀到中文亂碼。（2026-07-16 每日健檢發現 llms.txt 未帶 charset）
AddType "text/plain; charset=UTF-8" .txt
AddCharset UTF-8 .txt

# 效能（2026-09-21 依 PageSpeed 稽核）：文字資源 gzip 壓縮——PSI「未套用壓縮功能」項
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json text/plain image/svg+xml application/xml
</IfModule>

# 效能：靜態資源快取——PSI「快取 TTL 全為 None、可省 1,060KiB」項
# 注意：i18n.js 靠 ?v= 破快取（改 i18n 必 bump ?v=，既有鐵則）；posts.json 給 10 分鐘讓新貼文快速可見
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType image/x-icon "access plus 30 days"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType text/javascript "access plus 7 days"
ExpiresByType application/json "access plus 10 minutes"
ExpiresByType text/html "access plus 10 minutes"
</IfModule>

# 🔒 資安標頭（2026-10-24 資安第八輪；包 IfModule＝主機沒開 mod_headers 也不會 500）
#   HSTS：一年內瀏覽器只走 https（刻意不加 includeSubDomains——cpanel／webmail 等子網域不受影響）
#   nosniff：已實測 .js／.css／.json 的 Content-Type 都正確，加了不會擋到正常檔案
#   SAMEORIGIN＋frame-ancestors：別的網站不能把官網包進 iframe 騙點擊（CRM 沒有內嵌官網，已查）
#   CSP 只放不影響載入的三項；不限制 script 來源（GA、地圖、內嵌程式很多，硬加會整站壞）
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
Header always unset X-Powered-By
</IfModule>
